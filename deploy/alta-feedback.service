[Unit]
Description=ALTA feedback form (alta.smolevich.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/alta-feedback
# ADMIN_TOKEN, IP_SALT и DATA_DIR кладёт деплой из Vault; схему SQLite процесс заводит сам.
EnvironmentFile=/opt/alta-feedback/.env
ExecStart=/opt/alta-feedback/.venv/bin/python -m uvicorn --factory alta_feedback.main:create_app --host 127.0.0.1 --port 8101 --no-server-header --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
# ProtectHome не ставим: python venv — ссылка на интерпретатор uv в /root/.local.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/alta-feedback/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
